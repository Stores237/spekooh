# Copy to .env and adjust for your machine. Never commit the real .env.

# Local Postgres today; swap this single value for a Supabase Postgres
# connection string later — nothing else in settings needs to change.
DATABASE_URL=postgres://postgres@localhost:5432/spekooh

DJANGO_SECRET_KEY=dev-secret-key-change-me-please-at-least-32-bytes-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HMAC secret used to sign the QR pamphlet-pickup tokens.
QR_SIGNING_SALT=spekooh-pamphlet-qr

# Instructor webhook replay-protection window, in seconds.
INSTRUCTOR_WEBHOOK_MAX_SKEW_SECONDS=300

# Optional — media storage. Unset (the default), uploads go to local disk
# (MEDIA_ROOT). Set all five to switch to real Supabase Storage (an
# S3-compatible bucket, private by default — file URLs become signed,
# expiring links, not static paths). Get these from the Supabase dashboard:
# Project Settings -> Storage -> S3 Connection (access/secret keys) and the
# bucket you created there.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=spekooh-media
# AWS_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=eu-west-1
