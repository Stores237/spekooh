# Copy to .env and adjust for your machine. Never commit the real .env.

# Local Postgres today; swap this single value for a Supabase Postgres
# connection string later — nothing else in settings needs to change.
DATABASE_URL=postgres://postgres@localhost:5432/spekooh

DJANGO_SECRET_KEY=dev-secret-key-change-me-please-at-least-32-bytes-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HMAC secret used to sign the QR pamphlet-pickup tokens.
QR_SIGNING_SALT=spekooh-pamphlet-qr

# Instructor webhook replay-protection window, in seconds.
INSTRUCTOR_WEBHOOK_MAX_SKEW_SECONDS=300
