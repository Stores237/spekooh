# Local Claude Code session state — not project config.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.gstack/

# OS cruft
.DS_Store

# Local dev-session scratch — downloaded tools (e.g. cloudflared, see
# RUNNING_LOCALLY.md §3.1) and server logs. Never something to commit.
/tools/
*.log

# Root-level secrets (e.g. SUPABASE_ACCESS_TOKEN for the S@Learn CLI).
# Was previously excluded only in .git/info/exclude, which is local to one
# clone and not shared with anyone else who checks this repo out.
/.env

# app/ and backend/ have their own .gitignore for their toolchains.
