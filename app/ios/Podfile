# Deliberately not commented out, unlike Flutter's default template --
# pinned to match ios/Runner.xcodeproj/project.pbxproj's real
# IPHONEOS_DEPLOYMENT_TARGET (13.0), which every installed plugin's own
# podspec already declares as its minimum (image_picker_ios,
# cunning_document_scanner, local_auth_darwin, google_mobile_ads all
# s.ios.deployment_target/platform = 13.0; file_picker's own minimum,
# 12.0, is already covered by this). Verified against each plugin's real
# .podspec in this project's pub cache -- not left to CocoaPods' own
# implicit default, which is older and would otherwise create a silent
# mismatch the first time `pod install` actually ran.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Real build failure found live (2026-09-18, this project's
    # first-ever iOS build): google_mobile_ads 9.1.0 added
    # FLTAdPreloader.h/FLTAd_Internal.h, which #import
    # <GoogleMobileAds/GoogleMobileAds_Beta.h> -- a private header not
    # declared in GoogleMobileAds.framework's own module map. With
    # use_frameworks! (above) and Xcode's Clang modules on by default,
    # that's a hard build error ("Include of non-modular header inside
    # framework module"), not a warning. This is a known, documented
    # regression in this exact plugin version (confirmed via real
    # community reports, not guessed), not a misconfiguration on this
    # project's side -- CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_
    # MODULES is the standard, official way CocoaPods projects allow a
    # pod's own private cross-header include like this.
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end
end
